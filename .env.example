# Telegram API для аккаунта-читателя каналов: https://my.telegram.org → API development tools
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash

# Бот, который публикует дайджест и показывает меню админа: создаётся у @BotFather
BOT_TOKEN=123456789:your_bot_token
# Ваш Telegram id: только этот пользователь управляет ботом (узнать можно у @userinfobot)
ADMIN_ID=123456789
# Куда публиковать: @username канала или числовой id (-100...). Бот должен быть админом канала
PUBLISH_CHAT_ID=@your_channel

# LLM: по умолчанию DeepSeek. Подойдёт любой OpenAI-совместимый API с /chat/completions и JSON-режимом
DEEPSEEK_API_KEY=your_llm_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Хранилище и сессия аккаунта-читателя (сессию создаёт scripts/login.py)
DB_PATH=data/ai_news_digest.db
SESSION_DIR=data/session
SESSION_NAME=news_userbot
# Необязательно: файл сессии в base64, если у контейнера нет постоянного тома (python scripts/login.py --print-base64)
SESSION_BASE64=

# Расписание: сбор сайтов незадолго до выпуска, два выпуска в день
TIMEZONE=UTC
MORNING_WEB_FETCH=08:15
MORNING_DIGEST_TIME=09:00
EVENING_WEB_FETCH=18:15
EVENING_DIGEST_TIME=19:00

# Состав выпуска
DEFAULT_NEWS_COUNT=7
DEFAULT_USEFUL_COUNT=3
DEDUP_WINDOW_DAYS=14
MAX_PER_SOURCE=1
RELAXED_MAX_PER_SOURCE=2

# Необязательно: каналы, которые не нужны в сводке непрочитанного, через запятую
UNREAD_EXCLUDED_USERNAMES=
UNREAD_EXCLUDED_TITLES=

LOG_LEVEL=INFO
